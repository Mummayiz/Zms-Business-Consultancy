# Public origin of the deployment, no trailing slash. Drives canonical URLs,
# Open Graph, the sitemap and JSON-LD. Falls back to https://example.com.
NEXT_PUBLIC_SITE_URL=

# Contact form (Resend). Copy to .env.local for development, or set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# If any value is missing, /api/contact returns 503 and the form shows
# "The form isn't connected yet — please email us directly."

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives enquiries
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend, e.g. "ZMS Website <website@yourdomain.ae>"
CONTACT_FROM_EMAIL=
